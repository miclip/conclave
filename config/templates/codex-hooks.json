{
  "description": "Conclave hooks. Rendered from config/templates/codex-hooks.json.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{REPO_ROOT}}/spikes/hooks/hook_post.py codex",
            "async": false,
            "timeout": 10,
            "statusMessage": "conclave: recording SessionStart"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{REPO_ROOT}}/spikes/hooks/hook_post.py codex",
            "async": false,
            "timeout": 10,
            "statusMessage": "conclave: recording UserPromptSubmit"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{REPO_ROOT}}/spikes/hooks/hook_post.py codex",
            "async": false,
            "timeout": 10,
            "statusMessage": "conclave: recording PermissionRequest"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{REPO_ROOT}}/spikes/hooks/hook_post.py codex",
            "async": false,
            "timeout": 10,
            "statusMessage": "conclave: recording Stop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{REPO_ROOT}}/spikes/hooks/hook_post.py codex",
            "async": false,
            "timeout": 10,
            "statusMessage": "conclave: recording SessionEnd"
          }
        ]
      }
    ]
  }
}
