{
  "name": "conclave",
  "version": "0.4.0",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "description": "Multi-agent orchestrator REPL. One runtime dependency (node-pty); Node 24 strips types natively and node:test is built in.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "npm run typecheck && node --test --test-concurrency=4 'src/**/*.test.ts'",
    "test:live": "ORCH_LIVE=1 node --test src/adapters/claude.live.test.ts",
    "conformance": "node src/conformance/report.ts",
    "postinstall": "node scripts/fix-node-pty.cjs",
    "spike:outcomes": "python3 spikes/transcripts/outcomes.py --validate",
    "spike:env": "python3 tests/test_childenv.py",
    "spike:codex-hooks": "python3 spikes/hooks/verify_codex_hooks.py",
    "test:codex": "ORCH_CODEX=1 node --test src/deployment/codexHookTrust.test.ts",
    "config:install": "node bin/conclave.ts config install",
    "test:codex:real": "ORCH_CODEX_REAL=1 node --test src/deployment/codexHookTrust.test.ts",
    "config:check": "node bin/conclave.ts config check",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test 'src/**/*.test.ts'",
    "test:live:codex": "ORCH_LIVE_CODEX=1 node --test src/adapters/codex.live.test.ts",
    "test:live:relay": "ORCH_LIVE_RELAY=1 node --test src/relay/relay.live.test.ts",
    "test:live:pause": "ORCH_LIVE_PAUSE=1 node --test src/relay/pause.live.test.ts",
    "test:live:rotate": "ORCH_LIVE_ROTATE=1 node --test src/rotation/rotate.live.test.ts",
    "test:live:rollback": "ORCH_LIVE_ROLLBACK=1 node --test src/rotation/rotate.rollback.live.test.ts",
    "test:live:claim": "ORCH_LIVE_CLAIM=1 node --test src/rotation/acceptanceClaim.live.test.ts",
    "test:live:authority": "ORCH_LIVE_AUTHORITY=1 node --test src/relay/authority.live.test.ts",
    "session": "node bin/conclave.ts session"
  },
  "dependencies": {
    "node-pty": "^1.0.0"
  },
  "bin": {
    "conclave": "bin/conclave.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  }
}
